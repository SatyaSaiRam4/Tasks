# Copy this file to .env and fill in real values. Never commit the real .env.

# --- Database (required) ---
HOST=your-db-host.example.com
PORT=5432
DATABASE=postgres
USER=your-db-user
PASSWORD=your-db-password

# --- JWT / auth (optional, sensible defaults if omitted) ---
JWT_SECRET=  # required in production: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- SMTP / email (optional, reserved for OTP / password-reset) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=Rememberly
RESEND_API_KEY=
RESEND_FROM=
EMAIL_PROVIDER=auto
SMTP_DEBUG=true

# --- Admin bootstrap account (optional) ---
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@rememberly.app
ADMIN_PASSWORD=Admin@123

# --- Supabase Storage (optional, reserved for attachments/avatars) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=attachments

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:5173

# --- Redis (optional, reserved for future use) ---
REDIS_URL=

# --- MSG91 WhatsApp (optional reminder side-channel) ---
# Leave MSG91_AUTH_KEY blank to disable WhatsApp sending; reminders still
# work as local push notifications either way.
# MSG91_WHATSAPP_NAMESPACE is per-template — find it on MSG91's dashboard
# under Templates -> your template's Code{JSON} icon.
MSG91_AUTH_KEY=
MSG91_WHATSAPP_INTEGRATED_NUMBER=
MSG91_WHATSAPP_TEMPLATE_NAME=
MSG91_WHATSAPP_NAMESPACE=

# How often the reminder worker polls for due WhatsApp sends (seconds).
REMINDER_POLL_SECONDS=20

# --- Vault encryption (required once anyone uses the Vault) ---
# Comma-separated Fernet keys; the first encrypts, all can decrypt (rotation).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# BACK THIS UP outside the database: losing it means losing every Vault entry.
VAULT_ENCRYPTION_KEYS=
VAULT_SESSION_MAX_MINUTES=720
VAULT_MAX_FAILED_ATTEMPTS=5
VAULT_LOCKOUT_MINUTES=5

# --- Streaks & Track completion bonus ---
# bonus = floor(days * PER_DAY * difficulty), only for Tracks >= MIN_DAYS long
TRACK_BONUS_MIN_DAYS=7
TRACK_BONUS_PER_DAY=1.0
TRACK_BONUS_DIFFICULTY_STEP=0.1
TRACK_BONUS_DIFFICULTY_CAP=4
TRACK_BONUS_REQUIRE_PERFECT=true
TRACK_BONUS_MIN_COMPLETION=0.9
STREAK_FINALIZE_MINUTES=15
