        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:maxLines="1"
        android:paddingEnd="8dp"
        android:text=""
        android:textColor="#C8EFE9DC"
        android:textSize="11.5sp"
        android:visibility="gone" />

