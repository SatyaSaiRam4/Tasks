<?xml version="1.0" encoding="utf-8"?>
<!-- "Memo · Today" (4×1): one slim row with the M logo, the streak, today's tasks, the next reminder and the weather. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/memo_widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingTop="6dp"
    android:paddingEnd="14dp"
    android:paddingBottom="6dp">

    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="22dp"
        android:layout_marginEnd="8dp"
        android:adjustViewBounds="true"
        android:contentDescription="Memo"
        android:scaleType="fitCenter"
        android:src="@drawable/memo_widget_mark" />

    <TextView
        android:id="@+id/widget_streak"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:text="🔥 0"
        android:textColor="#F3DCA6"
        android:textSize="20sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_today"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Open Memo to see today"
            android:textColor="#EFE9DC"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/widget_next"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text=""
            android:textColor="#A8EFE9DC"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_weather"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:maxWidth="110dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text=""
        android:textColor="#C8EFE9DC"
        android:textSize="11.5sp"
        android:visibility="gone" />
</LinearLayout>
